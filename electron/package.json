{
  "name": "interview-ai-electron",
  "version": "1.0.0",
  "description": "Interview AI Electron Client",
  "author": "Interview AI Team",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy-renderer",
    "copy-renderer": "node -e \"const fs=require('fs');const path=require('path');if(!fs.existsSync('dist'))fs.mkdirSync('dist');fs.cpSync('renderer',path.join('dist','renderer'),{recursive:true,force:true})\"",
    "start": "electron dist/main.js",
    "dev": "tsc && npm run copy-renderer && electron dist/main.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:inject-key": "npm run build && node scripts/inject-api-key.js && electron-builder --win",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/ws": "^8.5.10",
    "cross-env": "^10.1.0",
    "electron": "28.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.interviewai.app",
    "productName": "Interview AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
